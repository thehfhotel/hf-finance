{
  "name": "kbiz-bot",
  "module": "src/login.ts",
  "type": "module",
  "scripts": {
    "login": "node --import tsx --env-file=.env src/login.ts",
    "verify": "node --import tsx --env-file=.env src/verify-session.ts",
    "list": "node --import tsx --env-file=.env src/list-payroll-accounts.ts",
    "add-payroll": "node --import tsx --env-file=.env src/add-payroll.ts",
    "transfer-payroll": "node --import tsx --env-file=.env src/transfer-payroll.ts",
    "transfer-other": "node --import tsx --env-file=.env src/transfer-other.ts",
    "transfer-other-probe": "node --import tsx --env-file=.env src/transfer-other-probe.ts",
    "process-queue": "node --import tsx --env-file=.env src/process-queue.ts",
    "install-browser": "bunx playwright install chromium",
    "probe-duplicate-popup": "bun run src/probe-duplicate-popup-dom.ts",
    "probe-payee-picker": "KBIZ_SLIPS_DIR=${TMPDIR:-/tmp}/kbiz-probe-slips bun run src/probe-payee-picker-pagination.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
