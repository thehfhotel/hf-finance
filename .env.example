KBIZ_USERNAME=your-kbiz-userid
KBIZ_PASSWORD=your-kbiz-password
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
PAYROLL_LEDGER_FEED_TOKEN=
PAYROLL_BANK_VERIFY_SINCE=

# ── Card login: "tap NFC staff card to unlock" (HF ID central service) ──────
# Server-to-server secret shared with the central HF ID service, sent as the
# X-Reader-Secret header. Leave UNSET to keep card login DARK: the
# /card-login/* routes return 503 and the admin modal shows "not configured".
READER_RESOLVE_SECRET=
# Central HF ID base URL — the evergreen LAN service, reachable from the
# container. Default (when unset) is http://192.168.100.228:5000.
HF_ID_BASE_URL=http://192.168.100.228:5000
# Expected card-assertion (id_token) issuer; must match the central OIDC
# issuer. Default (when unset) is https://id.thehfhotel.org/oidc.
HF_ID_ISSUER=https://id.thehfhotel.org/oidc
